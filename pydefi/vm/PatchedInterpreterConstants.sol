/*
 * Deterministic deployment constants for the **patched** Analog-Labs EVM
 * interpreter (`PatchedInterpreter.sol`).  Mirrors the upstream
 * `evm-interpreter/src/utils/Constants.sol` layout so the deploy pattern is
 * identical:
 *
 * ```solidity
 * import {IUniversalFactory} from "universal-factory/src/interfaces/IUniversalFactory.sol";
 * import {
 *     PATCHED_INTERPRETER_ADDRESS,
 *     PATCHED_INTERPRETER_CREATE2_SALT,
 *     PATCHED_INTERPRETER_CREATION_CODE
 * } from "pydefi/vm/PatchedInterpreterConstants.sol";
 *
 * IUniversalFactory factory = IUniversalFactory(PATCHED_INTERPRETER_CREATE2_DEPLOYER);
 * address interpreter = factory.create2(PATCHED_INTERPRETER_CREATE2_SALT, PATCHED_INTERPRETER_CREATION_CODE);
 * require(interpreter == PATCHED_INTERPRETER_ADDRESS);
 * ```
 *
 * AUTO-GENERATED by `scripts/patch_interpreter.py --emit`.  Do not edit
 * manually — re-run the script.  Bump the version suffix in
 * `_SALT_PREIMAGE` whenever the patched bytecode changes (different opcode
 * set disabled, upstream interpreter rev, etc.) so the CREATE2 address
 * shifts and stale deployments don't get confused with the new bytecode.
 */
pragma solidity >=0.7.0 <0.9.0;

/**
 * @dev UniversalFactory used to deploy at a deterministic address.  Same
 *      factory Analog-Labs uses for the upstream interpreter, so every chain
 *      where the upstream exists already has this factory.
 */
address constant PATCHED_INTERPRETER_CREATE2_DEPLOYER = 0x0000000000001C4Bf962dF86e38F0c10c7972C6E;

/**
 * @dev EIP-1014 CREATE2 salt = `keccak256('pydefi.PatchedInterpreter.v1')`.
 */
bytes32 constant PATCHED_INTERPRETER_CREATE2_SALT =
    0xc4481f251e5a8e775f9e10213d39d194a1bbeac6e0173105d6f7999c6a6c3d6c;

/**
 * @dev Address at which the patched interpreter is deployed via
 *      `UniversalFactory.create2(SALT, CREATION_CODE)`.
 */
address constant PATCHED_INTERPRETER_ADDRESS = 0x64fE558B0F9a5dC18D4A36c85Ba99c3f222F7bde;

/**
 * @dev Runtime codehash (`EXTCODEHASH`) of the deployed patched interpreter.
 *      Identical across chains.
 *
 *      Off-chain verification anchor only: the deploy script and fork-test
 *      fixture compare against it before deploying/reusing.  Not asserted
 *      on-chain — on the default path the address is CREATE2-bound to
 *      `PATCHED_INTERPRETER_INITCODE_HASH`, so code-present already implies
 *      the patched runtime (constructors only guard against *absent* code via
 *      `InterpreterNotDeployed`).
 */
bytes32 constant PATCHED_INTERPRETER_CODEHASH =
    0xa02da76871a49f730d82341d2a5abd702d1bd95576d4f932402b50fd3773e860;

/**
 * @dev `keccak256(PATCHED_INTERPRETER_CREATION_CODE)` — fed into the
 *      CREATE2 address derivation above.  Different from
 *      `PATCHED_INTERPRETER_CODEHASH` (which hashes the *runtime* code).
 */
bytes32 constant PATCHED_INTERPRETER_INITCODE_HASH =
    0x0053ea2eece200c208242b5baf3194f04c40e0aa6394660b3d64200500aba14f;

/**
 * @dev Full creation bytecode of `PatchedInterpreter` — the Analog-Labs
 *      interpreter with these handler slots replaced by the interpreter's
 *      own existing `5b fe 00 7b + 28 zero` "disabled handler" template:
 *
 *        offset 0x0ab8  op 0x54  SLOAD
 *        offset 0x0ad8  op 0x55  SSTORE
 *        offset 0x1e78  op 0xf2  CALLCODE
 *        offset 0x1eb8  op 0xf4  DELEGATECALL
 *        offset 0x2018  op 0xff  SELFDESTRUCT
 *
 *      TSTORE (0x5D), TLOAD (0x5C), and all other opcodes are unchanged
 *      from upstream.
 */
bytes constant PATCHED_INTERPRETER_CREATION_CODE = hex"";
